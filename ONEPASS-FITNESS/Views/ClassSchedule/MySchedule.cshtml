@model ONEPASS_FITNESS.Controllers.MyScheduleViewModel
@inject TimeZoneInfo Tz
@{
    ViewData["Title"] = "My Schedule";
}

<h1>Schedule</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.UpcomingBookings.Any() && !Model.PastBookings.Any())
{
    <div class="alert alert-info">
        <p>You don't have any bookings yet.</p>
        <a asp-action="Index" class="btn btn-primary">Book a Class</a>
    </div>
}
else
{
    @if (Model.UpcomingBookings.Any())
    {
        <h3 class="mt-4">Upcoming Classes</h3>
        @foreach (var group in Model.UpcomingBookings.GroupBy(b => b.ClassSession.StartTime.Date))
        {
            <h5>@group.Key.ToString("dddd, MMM d")</h5>
            <div class="list-group mb-3">
                @foreach (var booking in group)
                {
                    var startLocal = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(booking.ClassSession.StartTime, DateTimeKind.Utc), Tz);
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@booking.ClassSession.ClassType?.Name</strong>
                            <div class="text-muted">@startLocal.ToString("HH:mm")</div>
                        </div>
                        <div>
                            <form asp-action="Cancel" method="post" class="d-inline">
                                <input type="hidden" name="bookingId" value="@booking.Id" />
                                <button type="submit" class="btn btn-sm btn-warning">Cancel</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (Model.PastBookings.Any())
    {
        <h3 class="mt-4">Past Classes</h3>
        @foreach (var group in Model.PastBookings.GroupBy(b => b.ClassSession.StartTime.Date))
        {
            <h5>@group.Key.ToString("dddd, MMM d")</h5>
            <div class="list-group mb-3">
                @foreach (var booking in group)
                {
                    var startLocal = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(booking.ClassSession.StartTime, DateTimeKind.Utc), Tz);
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@booking.ClassSession.ClassType?.Name</strong>
                            <div class="text-muted">@startLocal.ToString("HH:mm")</div>
                        </div>
                    </div>
                }
            </div>
        }
    }
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Book Classes</a>
</div>
