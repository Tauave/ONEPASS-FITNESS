@model List<ONEPASS_FITNESS.Controllers.ClassTypeIndexViewModel>

@{
    ViewData["Title"] = "Class Types";
}

<h1>Class Types</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ Add Class Type</a>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Duration (min)</th>
                <th>Status</th>
                <th>Upcoming Sessions</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No class types found.</td>
                </tr>
            }
            else
            {
                @foreach (var classType in Model)
                {
                    <tr>
                        <td><strong>@classType.Name</strong></td>
                        <td>@(string.IsNullOrEmpty(classType.Description) ? "-" : classType.Description)</td>
                        <td>@classType.DurationMinutes</td>
                        <td>
                            @if (classType.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>@classType.UpcomingSessionCount</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@classType.Id" class="btn btn-sm btn-warning">Edit</a>
                            @if (classType.UpcomingSessionCount == 0)
                            {
                                <a asp-action="Delete" asp-route-id="@classType.Id" class="btn btn-sm btn-danger" 
                                   onclick="return confirm('Are you sure you want to delete this class type?');">Delete</a>
                            }
                            else
                            {
                                <form asp-action="Toggle" asp-route-id="@classType.Id" method="post" class="d-inline">
                                    @if (classType.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-warning" 
                                                onclick="return confirm('This class type has @classType.UpcomingSessionCount upcoming session(s). Are you sure you want to deactivate it?');">
                                            Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-success">Reactivate</button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
