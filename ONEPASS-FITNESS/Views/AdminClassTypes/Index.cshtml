@model List<ONEPASS_FITNESS.Models.ClassTypeListItemViewModel>
@{
    ViewData["Title"] = "Classes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">Classes</h1>
    <a class="btn btn-primary" asp-action="Create">Add class</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="text-muted">No classes yet.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Duration</th>
                <th>Upcoming sessions</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ct in Model)
            {
                <tr>
                    <td>@ct.Name</td>
                    <td>@ct.Description</td>
                    <td>@ct.DurationMinutes min</td>
                    <td>@ct.UpcomingSessionCount</td>
                    <td>
                        @if (ct.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@ct.Id">Edit</a>

                        <form asp-action="Toggle" asp-route-id="@ct.Id" method="post" class="d-inline"
                              onsubmit="return @(ct.IsActive && ct.UpcomingSessionCount > 0 ? $"confirm('{ct.Name} has {ct.UpcomingSessionCount} upcoming session(s). Deactivating hides it from new bookings but keeps those sessions and their bookings. Continue?')" : "true");">
                            <button type="submit" class="btn btn-sm @(ct.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                @(ct.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>

                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@ct.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
