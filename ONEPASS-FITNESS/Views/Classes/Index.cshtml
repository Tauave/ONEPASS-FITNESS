@model IEnumerable<ONEPASS_FITNESS.Models.Classes>

@{
    ViewData["Title"] = "Schedule";
}

<h1>Schedule</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-sm btn-outline-primary">Add Class</a>
    </p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Class</th>
            <th>Date</th>
            <th>Time</th>
            @if (User.IsInRole("Admin"))
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Classname</td>
                <td>@item.Date.ToString("dd MMM yyyy")</td>
                <td>@item.Starttime.ToString("hh\\:mm") - @item.Endtime.ToString("hh\\:mm")</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Classid" class="btn btn-sm btn-secondary">Edit</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
