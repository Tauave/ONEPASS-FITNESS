@model IEnumerable<ONEPASS_FITNESS.Models.ClassBookings>

@{
    ViewData["Title"] = "My Bookings";
}

<h1>My Bookings</h1>

@if (!Model.Any())
{
    <p class="text-muted">You don't have any classes booked.</p>
    <a asp-action="Create" class="btn btn-primary">Book a Class</a>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Class</th>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Class.Classname</td>
                    <td>@booking.Class.Date.ToString("dd MMM yyyy")</td>
                    <td>@booking.Class.Starttime.ToString("hh\\:mm") - @booking.Class.Endtime.ToString("hh\\:mm")</td>
                    <td>@booking.AttendanceStatus</td>
                </tr>
            }
        </tbody>
    </table>
}
