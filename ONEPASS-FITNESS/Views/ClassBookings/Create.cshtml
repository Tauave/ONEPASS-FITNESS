@model IEnumerable<ONEPASS_FITNESS.Models.Classes>

@{
    ViewData["Title"] = "Book a Class";
}

<h1>Book a Class</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Class</th>
            <th>Date</th>
            <th>Time</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Classname</td>
                <td>@item.Date.ToString("dd MMM yyyy")</td>
                <td>@item.Starttime.ToString("hh\\:mm") - @item.Endtime.ToString("hh\\:mm")</td>
                <td>
                    <form asp-action="Book" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="classId" value="@item.Classid" />
                        <button type="submit" class="btn btn-sm btn-primary">Book</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-link">View my bookings</a>
