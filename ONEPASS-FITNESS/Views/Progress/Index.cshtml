@model ONEPASS_FITNESS.Models.ProgressIndexViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Progress";
    var chartEntries = Model.Entries.Select(e => new { d = e.Date.ToString("yyyy-MM-dd"), w = e.WeightKg }).ToList();
    var chartAverage = Model.MovingAverage.Select(a => new { d = a.Date.ToString("yyyy-MM-dd"), w = a.AverageKg }).ToList();
    var targetWeight = Model.Goal?.TargetWeightKg;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Progress</h1>
    <a asp-action="Goal" class="btn btn-outline-primary">@(Model.Goal == null ? "Set goal" : "Edit goal")</a>
</div>

@if (Model.Goal == null)
{
    <div class="alert alert-info">Set a weight goal to see progress toward your target.</div>
}

@if (Model.Summary != null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Current (kg)</h6>
                    <p class="display-6 mb-0">@Model.Summary.Current.ToString("0.0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Change (kg)</h6>
                    <p class="display-6 mb-0">@Model.Summary.Change.ToString("+0.0;-0.0;0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Remaining (kg)</h6>
                    <p class="display-6 mb-0">@Model.Summary.Remaining.ToString("0.0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Toward goal</h6>
                    <div class="progress mt-2" style="height: 1.5rem;">
                        <div class="progress-bar" role="progressbar"
                             style="width: @Model.Summary.PercentToGoal.ToString("0")%"
                             aria-valuenow="@Model.Summary.PercentToGoal"
                             aria-valuemin="0" aria-valuemax="100">
                            @Model.Summary.PercentToGoal.ToString("0")%
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Entries.Count > 0)
{
    <div class="card mb-4">
        <div class="card-body">
            <canvas id="weightChart" height="120"></canvas>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Add weight record</div>
            <div class="card-body">
                <form asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewEntry.Date" class="form-label"></label>
                        <input asp-for="NewEntry.Date" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="NewEntry.Date" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewEntry.WeightKg" class="form-label"></label>
                        <input asp-for="NewEntry.WeightKg" class="form-control" />
                        <span asp-validation-for="NewEntry.WeightKg" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewEntry.Note" class="form-label"></label>
                        <textarea asp-for="NewEntry.Note" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="NewEntry.Note" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">Weigh-ins</div>
            <div class="card-body p-0">
                @if (Model.Entries.Count == 0)
                {
                    <p class="p-3 mb-0 text-muted">No entries yet. Log your first weigh-in.</p>
                }
                else
                {
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Weight (kg)</th>
                                <th>Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.Entries.OrderByDescending(e => e.Date))
                            {
                                <tr>
                                    <td>@entry.Date.ToString("d")</td>
                                    <td>@entry.WeightKg.ToString("0.0")</td>
                                    <td>@(entry.Note ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.Entries.Count > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const entries = @Html.Raw(JsonSerializer.Serialize(chartEntries));
            const movingAvg = @Html.Raw(JsonSerializer.Serialize(chartAverage));
            const targetWeight = @(targetWeight.HasValue ? targetWeight.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");

            const labels = entries.map(e => e.d);
            const datasets = [
                {
                    label: 'Weight (kg)',
                    data: entries.map(e => e.w),
                    tension: 0.3,
                    borderColor: 'rgb(13, 110, 253)',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    fill: false
                },
                {
                    label: '7-day average (kg)',
                    data: movingAvg.map(e => e.w),
                    tension: 0.3,
                    borderColor: 'rgb(25, 135, 84)',
                    borderDash: [4, 4],
                    fill: false
                }
            ];

            if (targetWeight != null) {
                datasets.push({
                    label: 'Target (kg)',
                    data: labels.map(() => targetWeight),
                    borderColor: 'rgb(220, 53, 69)',
                    borderDash: [8, 4],
                    pointRadius: 0,
                    fill: false
                });
            }

            new Chart(document.getElementById('weightChart'), {
                type: 'line',
                data: { labels, datasets },
                options: {
                    responsive: true,
                    scales: {
                        y: { title: { display: true, text: 'kg' } }
                    }
                }
            });
        </script>
    }
}
