@model IEnumerable<ONEPASS_FITNESS.Models.Progress>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Weight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateRecorded)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.appUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Weight)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateRecorded)
            </td>
            <td>
                @Html.DisplayFor(model => item.appUser)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProgressId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProgressId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProgressId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
