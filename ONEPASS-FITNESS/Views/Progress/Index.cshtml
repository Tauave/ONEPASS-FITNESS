@model IEnumerable<ONEPASS_FITNESS.Models.Progress>

@{
    ViewData["Title"] = "Progress";
}

<h1>Progress</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Log Weight</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">No progress recorded yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date Recorded</th>
                <th>Weight (kg)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td>@entry.DateRecorded.ToString("dd MMM yyyy")</td>
                    <td>@entry.Weight</td>
                </tr>
            }
        </tbody>
    </table>
}
