@model ONEPASS_FITNESS.Models.WeightGoal

@{
    ViewData["Title"] = "Weight goal";
}

<h1 class="mb-4">Weight goal</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Goal" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="StartWeightKg" class="form-label"></label>
                <input asp-for="StartWeightKg" class="form-control" />
                <span asp-validation-for="StartWeightKg" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TargetWeightKg" class="form-label"></label>
                <input asp-for="TargetWeightKg" class="form-control" />
                <span asp-validation-for="TargetWeightKg" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TargetDate" class="form-label"></label>
                <input asp-for="TargetDate" class="form-control" type="date" />
                <span asp-validation-for="TargetDate" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save goal</button>
            <a asp-action="Index" class="btn btn-link">Back to progress</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
