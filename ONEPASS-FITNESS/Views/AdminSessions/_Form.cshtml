@model ONEPASS_FITNESS.Models.ClassSessionViewModel
@{
    var classTypes = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewData["ClassTypes"]!;
    var isCreate = Model.Id == 0;
}

<div class="row">
    <div class="col-md-5">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="ClassTypeId" class="control-label"></label>
                <select asp-for="ClassTypeId" asp-items="classTypes" class="form-select">
                    <option value="">-- Select a class --</option>
                </select>
                <span asp-validation-for="ClassTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StartTime" class="control-label"></label>
                <input asp-for="StartTime" class="form-control" type="datetime-local" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Capacity" class="control-label"></label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" max="500" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            @if (isCreate)
            {
                <div class="form-group mb-3">
                    <label asp-for="RepeatWeeks" class="control-label"></label>
                    <input asp-for="RepeatWeeks" class="form-control" type="number" min="1" max="12" />
                    <div class="form-text">1 creates a single session. Weeks already in the past are skipped.</div>
                    <span asp-validation-for="RepeatWeeks" class="text-danger"></span>
                </div>
            }

            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
