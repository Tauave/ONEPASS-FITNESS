@model ONEPASS_FITNESS.Controllers.AdminSessionsController.SessionFormViewModel
@{
    ViewData["Title"] = Model.Id == null ? "Create session" : "Edit session";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="@(Model.Id == null ? "Create" : "Edit")" method="post">
    @if (Model.Id != null)
    {
        <input type="hidden" name="id" value="@Model.Id" />
    }

    <div class="mb-3">
        <label asp-for="ClassTypeId" class="form-label">Class type</label>
        <select asp-for="ClassTypeId" class="form-select" asp-items="Model.ClassTypes"></select>
        <span asp-validation-for="ClassTypeId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartLocal" class="form-label">Start local</label>
        <input asp-for="StartLocal" type="datetime-local" class="form-control" />
        <span asp-validation-for="StartLocal" class="text-danger"></span>
    </div>

    @if (Model.Id == null)
    {
        <div class="mb-3">
            <label asp-for="RepeatWeeks" class="form-label">Repeat weekly for N weeks</label>
            <input asp-for="RepeatWeeks" type="number" min="1" max="12" class="form-control" />
            <small class="form-text text-muted">Create this session for 1-12 consecutive weeks at the same local time. Weeks in the past are skipped.</small>
            <span asp-validation-for="RepeatWeeks" class="text-danger"></span>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Capacity" class="form-label">Capacity</label>
        <input asp-for="Capacity" type="number" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
