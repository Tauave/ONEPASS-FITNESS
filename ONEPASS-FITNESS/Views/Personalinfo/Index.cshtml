@model ONEPASS_FITNESS.Models.Personalinfo

@{
    ViewData["Title"] = "Account";
}

<h1>Account</h1>
<p class="text-muted">Welcome @Model.Name</p>

<div class="row mt-4">
    <div class="col-md-6">
        <h4>Your details</h4>
        <dl class="row">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name @Model.Lastname</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Phone Number</dt>
            <dd class="col-sm-8">@Model.PhoneNumber</dd>

            <dt class="col-sm-4">Date of Birth</dt>
            <dd class="col-sm-8">@Model.DOB.ToString("dd MMM yyyy")</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.PersonalinfoId" class="btn btn-primary">Edit Profile</a>
    </div>

    <div class="col-md-6">
        <h4>Your bookings</h4>
        @if (!Model.ClassBookings.Any())
        {
            <p class="text-muted">You don't have any classes booked.</p>
            <a asp-controller="ClassBookings" asp-action="Create" class="btn btn-outline-primary">Book a Class</a>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Class</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.ClassBookings)
                    {
                        <tr>
                            <td>@booking.Class.Classname</td>
                            <td>@booking.Class.Date.ToString("dd MMM yyyy")</td>
                            <td>@booking.Class.Starttime.ToString("hh\\:mm") - @booking.Class.Endtime.ToString("hh\\:mm")</td>
                            <td>@booking.AttendanceStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
