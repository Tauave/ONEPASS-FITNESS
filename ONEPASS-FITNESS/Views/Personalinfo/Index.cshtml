@model IEnumerable<ONEPASS_FITNESS.Models.Personalinfo>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdentityUserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lastname)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DOB)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClassBookings)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Progress)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.IdentityUserId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Lastname)
            </td>
            <td>
                @Html.DisplayFor(model => item.DOB)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.PhoneNumber)
            </td>
            <td>
                @Html.DisplayFor(model => item.ClassBookings)
            </td>
            <td>
                @Html.DisplayFor(model => item.Progress)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PersonalinfoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PersonalinfoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.PersonalinfoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
