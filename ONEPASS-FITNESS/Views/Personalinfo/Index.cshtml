@model ONEPASS_FITNESS.Models.PersonalInfoViewModel
@{
    ViewData["Title"] = "Account";
}

<h1>Account</h1>

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success">@TempData["StatusMessage"]</div>
}

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">First name</dt>
            <dd class="col-sm-9">@Model?.Name</dd>

            <dt class="col-sm-3">Last name</dt>
            <dd class="col-sm-9">@Model?.Lastname</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model?.Email</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model?.PhoneNumber</dd>

            <dt class="col-sm-3">Date of birth</dt>
            <dd class="col-sm-9">@Model?.DOB</dd>
        </dl>

        <a class="btn btn-primary" asp-action="Edit">Edit profile</a>
    </div>
</div>
